# Required for the app to actually call Claude (the LLM layer). Get a key at
# https://console.anthropic.com/ and put it in a local .env (never committed):
ANTHROPIC_API_KEY=sk-ant-...

# Optional: nothing else is required. The database is a local SQLite file
# generated by db/seed.py, not a managed service, so there is no DB connection
# string to configure.
