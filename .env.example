# Required for the app to actually call Claude (the LLM layer). Get a key at
# https://console.anthropic.com/ and put it in a local .env (never committed).
# Left EMPTY here on purpose: `source .env` with a placeholder string here
# would make os.environ.get("ANTHROPIC_API_KEY") truthy, which turns the two
# @pytest.mark.skipif(not ANTHROPIC_API_KEY) real-LLM tests in tests/test_api.py
# from a clean skip into a real (failing) call with a fake key.
ANTHROPIC_API_KEY=

# PostgreSQL 17 (via `docker compose up -d`, see docker-compose.yml). The app
# connects as querymind_reader, a role with SELECT on the 5 approved views
# ONLY (see db/roles.sql) - never as the postgres superuser.
DATABASE_URL=postgresql://querymind_reader:querymind_reader_local_only@localhost:55901/querymind

# Admin/superuser connection. Used ONLY by db/seed.py and by
# tests/test_postgres_security.py (to prove the reader role's restrictions
# independently of its own grants). The running app never uses this.
ADMIN_DATABASE_URL=postgresql://postgres:querymind_admin_local_only@localhost:55901/querymind

# Optional: fixed-window rate limiting on /ask and /ask/stream (20 req/min
# per caller). Unset = no-op, no rate limiting applied, no error.
REDIS_URL=redis://localhost:63791/0
